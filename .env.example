# Optional settings. The default deployment uses Docker-managed storage.
SIMC_WEB_PORT=8088
# Address the port listens on. Use 0.0.0.0 to reach the runner from other devices.
SIMC_WEB_BIND=127.0.0.1
# Comma-separated host names, besides localhost and IP addresses, used to open the runner.
# SIMC_WEB_ALLOWED_HOSTS=simc.lan
TZ=UTC
SIMC_IMAGE=simulationcraftorg/simc:latest
# Check for a newer SimulationCraft image before every run.
SIMC_PULL_POLICY=always
SIMC_WEB_IMAGE=ghcr.io/bromeego/simc-local-runner:latest
SIMC_TIMEOUT_SECONDS=1800
MAX_UPLOAD_MB=2
# Capped at WEB_THREADS - 1 so the page stays responsive while simulations run.
MAX_CONCURRENT_SIMS=1
REPORT_RETENTION_COUNT=100
WEB_THREADS=4

# Optional Docker limits for each SimulationCraft run.
# SIMC_CPUS=4
# SIMC_MEMORY=4g

# Homelab bind-folder mode only. See docs/SETUP.md.
# COMPOSE_FILE=compose.yaml:compose.bind.yaml
# SIMC_WEB_ROOT=/srv/simc-web
